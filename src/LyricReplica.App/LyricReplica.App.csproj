<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LyricReplica</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.2.0" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" Aliases="emoji" />
    <Reference Include="ColorThief.Netstandard.v20"><HintPath>../../vendor/ColorThief/ColorThief.Netstandard.v20.dll</HintPath><Private>true</Private></Reference>
    <ProjectReference Include="../LyricReplica.Core/LyricReplica.Core.csproj" />
    <ProjectReference Include="../../vendor/Lyricify-Backgrounds/Lyricify.Backgrounds.AppleMusicInspired.Ios.Wpf/Lyricify.Backgrounds.AppleMusicInspired.Ios.Wpf.csproj" />
    <ProjectReference Include="../../vendor/Lyricify-Backgrounds/Lyricify.Backgrounds.AppleMusicInspired.IosClassic.Wpf/Lyricify.Backgrounds.AppleMusicInspired.IosClassic.Wpf.csproj" />
    <None Include="../../vendor/Lyricify-Backgrounds/LICENSE.txt" Link="licenses/Lyricify-Backgrounds.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../vendor/Wpf.Ui/LICENSE.txt" Link="licenses/Wpf.Ui.txt" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets/Fonts/*.otf" />
    <Resource Include="Assets/Fonts/*.ttf" />
    <Resource Include="Assets/Shaders/*.ps" />
    <None Update="Media/NetEaseClient.cjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../tests/LyricReplica.Tests/Fixtures/settings-controls-original.json" LogicalName="settings-controls-original.json" />
    <EmbeddedResource Include="../../tests/LyricReplica.Tests/Fixtures/plus-lighter-original.json" LogicalName="plus-lighter-original.json" />
    <EmbeddedResource Include="../../tests/LyricReplica.Tests/Fixtures/isolation-original.json" LogicalName="isolation-original.json" />
    <EmbeddedResource Include="../../tests/LyricReplica.Tests/Fixtures/palette-original.json" LogicalName="palette-original.json" />
    <EmbeddedResource Include="../../tests/LyricReplica.Tests/Fixtures/layout-original.json" LogicalName="layout-original.json" />
    <EmbeddedResource Include="../../tests/LyricReplica.Tests/Fixtures/fonts-original.json" LogicalName="reference-fonts.json" />
    <EmbeddedResource Include="../../tests/LyricReplica.Tests/Fixtures/early-finish-original.json" LogicalName="early-finish-original.json" />
    <EmbeddedResource Include="../../tests/LyricReplica.Tests/Fixtures/word-reset-original.json" LogicalName="word-reset-original.json" />
  </ItemGroup>
</Project>
