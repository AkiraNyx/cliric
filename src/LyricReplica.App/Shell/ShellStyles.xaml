<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:LyricReplica.App"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Color x:Key="Shell.AccentColor">#F0687A</Color>
    <SolidColorBrush x:Key="Shell.Background" Color="#161616" />
    <SolidColorBrush x:Key="Shell.Sidebar" Color="#1B1B1B" />
    <SolidColorBrush x:Key="Shell.Surface" Color="#222222" />
    <SolidColorBrush x:Key="Shell.SurfaceRaised" Color="#2B2B2B" />
    <SolidColorBrush x:Key="Shell.Stroke" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="Shell.ControlHover" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="Shell.Primary" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Shell.Secondary" Color="#B4B4B4" />
    <SolidColorBrush x:Key="Shell.Tertiary" Color="#929292" />
    <SolidColorBrush x:Key="Shell.Accent" Color="{StaticResource Shell.AccentColor}" />
    <FontFamily x:Key="Shell.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontWeight x:Key="Shell.SemiboldWeight">520</FontWeight>
    <FontWeight x:Key="Shell.BoldWeight">630</FontWeight>

    <Style TargetType="local:MiSansLabel">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MiSansLabel">
                    <TextBlock x:Name="Text" Text="{TemplateBinding Text}" TextWrapping="{TemplateBinding TextWrapping}"
                               TextTrimming="{TemplateBinding TextTrimming}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate DataType="{x:Type sys:String}">
        <local:MiSansLabel Text="{Binding}" />
    </DataTemplate>

    <Style x:Key="Shell.KeyboardFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{StaticResource Shell.Accent}" BorderThickness="2" CornerRadius="7" Margin="-2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Shell.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Shell.Icons}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>
    <Style x:Key="Shell.Heading" TargetType="local:MiSansLabel" BasedOn="{StaticResource {x:Type local:MiSansLabel}}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="{DynamicResource Shell.BoldWeight}" />
        <Setter Property="Foreground" Value="{StaticResource Shell.Primary}" />
    </Style>
    <Style x:Key="Shell.PageTitle" TargetType="local:MiSansLabel" BasedOn="{StaticResource Shell.Heading}">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="Shell.Caption" TargetType="local:MiSansLabel" BasedOn="{StaticResource {x:Type local:MiSansLabel}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Shell.Secondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Immediate feedback for controls used repeatedly during playback. -->
    <Style x:Key="Shell.Button" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource Shell.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.KeyboardFocus}" />
        <Setter Property="local:ShellAssist.CornerRadius" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="Surface" CornerRadius="{TemplateBinding local:ShellAssist.CornerRadius}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Hover" CornerRadius="{TemplateBinding local:ShellAssist.CornerRadius}"
                                Background="{StaticResource Shell.ControlHover}" Opacity="0" />
                        <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" RenderTransformOrigin="0.5,0.5"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Hover" Property="local:ShellTransitions.HoverOpacity" Value="1" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="local:ShellTransitions.HoverOpacity" Value="1" />
                            <Setter TargetName="Label" Property="Opacity" Value="0.78" />
                            <Setter TargetName="Label" Property="local:ShellTransitions.PressPose" Value="True" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Shell.Button}" />
    <Style x:Key="Shell.CaptionButton" TargetType="Button" BasedOn="{StaticResource Shell.Button}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style x:Key="Shell.Toggle" TargetType="ToggleButton" BasedOn="{StaticResource Shell.Button}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Shell.SurfaceRaised}" />
                <Setter Property="BorderBrush" Value="{StaticResource Shell.Stroke}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Shell.IconButton" TargetType="Button" BasedOn="{StaticResource Shell.Button}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="local:ShellAssist.CornerRadius" Value="18" />
    </Style>
    <Style x:Key="Shell.ModeButton" TargetType="Button" BasedOn="{StaticResource Shell.IconButton}">
        <Setter Property="Opacity" Value="0.55" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource Shell.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Shell.Pill" TargetType="Button" BasedOn="{StaticResource Shell.Button}">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="local:ShellAssist.CornerRadius" Value="19" />
        <Setter Property="BorderBrush" Value="#40FFFFFF" />
        <Setter Property="FontWeight" Value="{DynamicResource Shell.SemiboldWeight}" />
    </Style>
    <Style x:Key="Shell.PrimaryPill" TargetType="Button" BasedOn="{StaticResource Shell.Pill}">
        <Setter Property="Background" Value="{StaticResource Shell.Primary}" />
        <Setter Property="Foreground" Value="#0D0D0F" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style x:Key="Shell.NavButton" TargetType="Button" BasedOn="{StaticResource Shell.Button}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Foreground" Value="#CFCFD4" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- Text input -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Shell.Primary}" />
        <Setter Property="CaretBrush" Value="{StaticResource Shell.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Shell.Accent}" />
        <Setter Property="Background" Value="{StaticResource Shell.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Shell.Stroke}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Border x:Name="Hover" Background="#0AFFFFFF" CornerRadius="7" Opacity="0" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="local:ShellTransitions.HoverOpacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Shell.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Shell.SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Shell.Primary}" />
        <Setter Property="CaretBrush" Value="{StaticResource Shell.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Shell.Accent}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="#1EFFFFFF" CornerRadius="9" BorderThickness="1" BorderBrush="Transparent">
                        <Grid>
                            <Border x:Name="Hover" Background="#0AFFFFFF" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
                            <Grid Margin="11,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE721;" FontSize="13"
                                       Foreground="{StaticResource Shell.Secondary}" Margin="0,0,9,0" />
                            <local:MiSansLabel x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{StaticResource Shell.Tertiary}"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="local:ShellTransitions.HoverOpacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Shell.Accent}" />
                            <Setter TargetName="Frame" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch for every CheckBox inside the app shell -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Shell.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.KeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" MinHeight="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" RecognizesAccessKey="True" />
                        <Grid Grid.Column="1" Width="40" Height="22" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="11" Background="#3A3A40" />
                            <Border x:Name="On" CornerRadius="11" Background="{StaticResource Shell.Accent}" Opacity="0" />
                            <Border x:Name="Hover" CornerRadius="11" Background="#22FFFFFF" Opacity="0" IsHitTestVisible="False" />
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Knob" Property="local:ShellTransitions.SwitchOn" Value="True" />
                            <Setter TargetName="On" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="local:ShellTransitions.HoverOpacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider -->
    <Style x:Key="Shell.SliderEdge" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.KeyboardFocus}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Shell.SliderEdge}" Background="{StaticResource Shell.Primary}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Shell.SliderEdge}" Background="#40FFFFFF" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Ellipse Fill="White" Width="10" Height="10" />
                                                <Ellipse x:Name="Hover" Fill="{StaticResource Shell.Primary}" Opacity="0" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Hover" Property="local:ShellTransitions.HoverOpacity" Value="1" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Hover" Property="local:ShellTransitions.HoverOpacity" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ShellSlider" BasedOn="{StaticResource {x:Type Slider}}" />

    <!-- ComboBox -->
    <Style x:Key="Shell.ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" Background="{StaticResource Shell.SurfaceRaised}" BorderBrush="{StaticResource Shell.Stroke}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Border x:Name="Hover" Background="#0EFFFFFF" CornerRadius="7" Opacity="0" IsHitTestVisible="False" />
                            <TextBlock x:Name="Chevron" Style="{StaticResource Shell.Glyph}" Text="&#xE70D;" FontSize="11" Foreground="{StaticResource Shell.Secondary}"
                                       HorizontalAlignment="Right" Margin="0,0,12,0" RenderTransformOrigin="0.5,0.5" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="local:ShellTransitions.HoverOpacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Shell.Primary}" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.KeyboardFocus}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource Shell.ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="12,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="4,0,30,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               PopupAnimation="None" Focusable="False" VerticalOffset="4">
                            <Border Background="#242428" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="10" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,0,8,8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" />
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Shell.Primary}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.KeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Hover" Background="#20FFFFFF" CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Hover" Property="local:ShellTransitions.HoverOpacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Shell.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource Shell.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Foreground="{TemplateBinding Foreground}" Cursor="Hand" FocusVisualStyle="{StaticResource Shell.KeyboardFocus}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Frame" Background="Transparent" CornerRadius="8" Padding="0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Chevron" Style="{StaticResource Shell.Glyph}" Text="&#xE76C;"
                                                       FontSize="11" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5" />
                                            <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Margin="3,4,3,4">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb MinHeight="28">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="Handle" Background="#3DFFFFFF" CornerRadius="3" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Handle" Property="Background" Value="#73FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="Handle" Property="Background" Value="#A6FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Shell.Primary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#2A2A2F" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="6" Padding="9,5" Margin="0,0,6,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.4" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rows for the song list and search results -->
    <Style x:Key="Shell.Row" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource Shell.Primary}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.KeyboardFocus}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Selected" CornerRadius="8" Background="#1FFFFFFF" Opacity="0" />
                        <Border x:Name="Hover" CornerRadius="8" Background="#12FFFFFF" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="local:ShellTransitions.HoverOpacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Selected" Property="Opacity" Value="1" />
                        </Trigger>
