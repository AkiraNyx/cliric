<UserControl x:Class="LyricReplica.App.LibraryView" x:Name="ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LyricReplica.App"
             xmlns:reference="clr-namespace:LyricReplica.App.Reference"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Foreground="#F5F5F7" FontSize="14"
             UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextHintingMode="Animated" TextOptions.TextRenderingMode="Grayscale">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ShellStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NavItem" TargetType="Button">
                <Setter Property="Foreground" Value="#C7C7CC" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.KeyboardFocus}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="NavSurface" Background="Transparent">
                                <Border x:Name="Hover" CornerRadius="9" Background="#12FFFFFF" Opacity="0" />
                                <Border x:Name="Active" CornerRadius="9" Background="#22FFFFFF" Opacity="0" />
                                <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2" Background="{StaticResource Shell.Accent}"
                                        HorizontalAlignment="Left" Margin="2,0,0,0" Opacity="0" />
                                <ContentPresenter x:Name="Label" Margin="14,0,10,0" VerticalAlignment="Center" RenderTransformOrigin="0.06,0.5" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Hover" Property="local:ShellTransitions.HoverOpacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Label" Property="local:ShellTransitions.PressPose" Value="True" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter Property="Foreground" Value="#F5F5F7" />
                                    <Setter TargetName="Active" Property="Opacity" Value="1" />
                                    <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="NavSurface" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NavLabel" TargetType="local:MiSansLabel" BasedOn="{StaticResource {x:Type local:MiSansLabel}}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="12,0,0,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=local:LibraryView}}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="WideOnly" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=local:LibraryView}}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RoomyOnly" TargetType="local:MiSansLabel" BasedOn="{StaticResource {x:Type local:MiSansLabel}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsNarrow, RelativeSource={RelativeSource AncestorType=local:LibraryView}}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SectionLabel" TargetType="local:MiSansLabel" BasedOn="{StaticResource NavLabel}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="{DynamicResource Shell.SemiboldWeight}" />
                <Setter Property="Foreground" Value="{StaticResource Shell.Tertiary}" />
                <Setter Property="Margin" Value="14,18,0,6" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Shell.Surface}" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="22,18" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="PageScroller" TargetType="local:ShellScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Visibility" Value="Collapsed" />
            </Style>
            <Style x:Key="PageTitleSlot" TargetType="Border">
                <Setter Property="Height" Value="{Binding ActualHeight, ElementName=TitleText}" />
                <EventSetter Event="SizeChanged" Handler="OnTitleSizeChanged" />
            </Style>
            <ControlTemplate x:Key="BareList" TargetType="ListBox">
                <ItemsPresenter />
            </ControlTemplate>
            <DataTemplate x:Key="NetEaseTrackRow">
                <Grid x:Name="ResultRow" Background="Transparent" MouseRightButtonUp="OpenSongQueueMenu">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="{Binding AlbumColumn, RelativeSource={RelativeSource AncestorType=local:LibraryView}}" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Availability" />
                        <ColumnDefinition Width="Auto" MinWidth="56" SharedSizeGroup="TrackDuration" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="44" Height="44" HorizontalAlignment="Left">
                        <Border CornerRadius="8" Background="{StaticResource Shell.SurfaceRaised}">
                            <Image Source="{DynamicResource Apple.Music.Song}" Width="20" Height="20" Opacity="0.4" />
                        </Border>
                        <Rectangle RadiusX="8" RadiusY="8">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <local:MiSansLabel Text="{Binding Track.Title}" FontWeight="{DynamicResource Shell.SemiboldWeight}" TextTrimming="CharacterEllipsis" />
                        <local:MiSansLabel Text="{Binding Track.Artist}" Style="{StaticResource Shell.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <local:MiSansLabel Grid.Column="2" Text="{Binding Track.Album}" Style="{StaticResource Shell.Caption}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Border Grid.Column="3" CornerRadius="7" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" Background="#1AFFFFFF">
                        <local:MiSansLabel Text="{Binding Track.Availability}" FontSize="11" Foreground="{StaticResource Shell.Secondary}" />
                    </Border>
                    <local:MiSansLabel x:Name="DurationLabel" Grid.Column="4" Text="{Binding Duration}" Style="{StaticResource Shell.Caption}" FontSize="12" TextTrimming="None"
                                      VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" />
                    <Button x:Name="RowPlay" Grid.Column="5" Style="{StaticResource Shell.IconButton}" Width="32" Height="32" Opacity="0"
                            Click="PlaySearchResultButton" Tag="{Binding}" ToolTip="播放" AutomationProperties.Name="播放"
                            HorizontalAlignment="Right" IsEnabled="{Binding Track.Playable}">
                        <Image Source="{DynamicResource Apple.Music.PlayButton}" Width="22" Height="22">
                            <Image.RenderTransform><TranslateTransform X="1" /></Image.RenderTransform>
                        </Image>
                    </Button>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="RowPlay" Property="local:ShellTransitions.HoverOpacity" Value="1" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="RowPlay" Property="local:ShellTransitions.HoverOpacity" Value="1" />
                    </DataTrigger>
                    <Trigger SourceName="RowPlay" Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="RowPlay" Property="local:ShellTransitions.HoverOpacity" Value="1" />
                    </Trigger>
                    <DataTrigger Binding="{Binding Track.Playable}" Value="False">
                        <Setter TargetName="ResultRow" Property="Opacity" Value="0.45" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <Style x:Key="GlyphMask" TargetType="Rectangle">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Fill" Value="#0D0D0F" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="LibraryRoot" RenderOptions.ClearTypeHint="Enabled">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border x:Name="Sidebar" Background="{StaticResource Shell.Sidebar}" BorderBrush="{StaticResource Shell.Stroke}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,0,10,12">
                <Button x:Name="NavSettings" DockPanel.Dock="Bottom" Style="{StaticResource NavItem}" Click="ShowSettingsPage" ToolTip="设置" AutomationProperties.Name="设置">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE713;" Width="22" />
                        <local:MiSansLabel Style="{StaticResource NavLabel}" Text="设置" />
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Top">
                    <Grid Height="58" Background="Transparent">
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource Shell.Accent}">
                                <Image Source="{DynamicResource Apple.Music.Song}" Width="19" Height="19" />
                            </Border>
                            <local:MiSansLabel Style="{StaticResource NavLabel}" Text="LyricReplica" FontSize="15" FontWeight="{DynamicResource Shell.SemiboldWeight}" />
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="SidebarSearch" Style="{StaticResource Shell.SearchBox}" Tag="搜索歌曲、艺人" Margin="0,0,0,14"
                             KeyDown="OnSidebarSearchKeyDown" AutomationProperties.Name="搜索网易云音乐，按回车搜索">
                        <TextBox.Visibility>
                            <Binding Path="IsCompact" RelativeSource="{RelativeSource AncestorType=local:LibraryView}" Converter="{x:Static local:LibraryView.CollapsedWhenTrue}" />
                        </TextBox.Visibility>
                    </TextBox>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <Button x:Name="NavHome" Style="{StaticResource NavItem}" Click="ShowHomePage" Tag="True" ToolTip="主页" AutomationProperties.Name="主页">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE80F;" Width="22" />
                            <local:MiSansLabel Style="{StaticResource NavLabel}" Text="主页" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSearch" Style="{StaticResource NavItem}" Click="ShowSearchPage" ToolTip="搜索" AutomationProperties.Name="搜索">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE721;" Width="22" />
                            <local:MiSansLabel Style="{StaticResource NavLabel}" Text="搜索" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavRecent" Style="{StaticResource NavItem}" IsEnabled="False" ToolTip="最近播放（预留）"
                            ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="最近播放（预留）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE81C;" Width="22" />
                            <local:MiSansLabel Style="{StaticResource NavLabel}" Text="最近播放" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavDownloads" Style="{StaticResource NavItem}" IsEnabled="False" ToolTip="下载管理（预留）"
                            ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="下载管理（预留）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE896;" Width="22" />
                            <local:MiSansLabel Style="{StaticResource NavLabel}" Text="下载管理" />
                        </StackPanel>
                    </Button>
                    <local:MiSansLabel Style="{StaticResource SectionLabel}" Text="网易云音乐" />
                    <Button x:Name="NavLiked" Style="{StaticResource NavItem}" Click="OpenLikedPlaylist"
                            ToolTip="我喜欢的音乐" AutomationProperties.Name="网易云音乐 · 我喜欢的音乐">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xEB51;" Width="22" />
                            <local:MiSansLabel Style="{StaticResource NavLabel}" Text="我喜欢的音乐" />
                        </StackPanel>
                    </Button>

                    <local:MiSansLabel Style="{StaticResource SectionLabel}" Text="添加音乐" />
                    <Button Style="{StaticResource NavItem}" Click="OpenAudio" ToolTip="添加本地音频" AutomationProperties.Name="添加音频">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE8D6;" Width="22" />
                            <local:MiSansLabel Style="{StaticResource NavLabel}" Text="添加音频" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}" Click="ImportLyrics" ToolTip="导入 LRC、TTML 或 JSON 歌词" AutomationProperties.Name="导入歌词">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE8A5;" Width="22" />
                            <local:MiSansLabel Style="{StaticResource NavLabel}" Text="导入歌词" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}" Click="ConnectMedia" ToolTip="跟随系统正在播放的媒体" AutomationProperties.Name="连接系统媒体">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE93E;" Width="22" />
                            <local:MiSansLabel Style="{StaticResource NavLabel}" Text="连接系统媒体" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Pages -->
        <Grid x:Name="PageHost" Grid.Column="1" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="1" Background="{StaticResource Shell.Background}" />
            <local:ShellScrollViewer x:Name="HomePage" Grid.Row="1" Style="{StaticResource PageScroller}" Visibility="Visible" ScrollChanged="OnPageScrolled">
                <StackPanel x:Name="HomeContent" Margin="40,16,40,36">
                    <Border x:Name="HomeTitleSlot" Style="{StaticResource PageTitleSlot}" />

                    <Grid x:Name="Hero" MinHeight="228" Margin="0,20,0,28" SizeChanged="OnHeroSizeChanged">
                        <Rectangle Fill="{StaticResource Shell.Surface}" />
                        <Grid x:Name="HeroContent" Margin="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="HeroArt" Width="184" Height="184">
                                <Border CornerRadius="10" Background="{StaticResource Shell.SurfaceRaised}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.5" />
                                    </Border.Effect>
                                </Border>
                                <Rectangle RadiusX="10" RadiusY="10">
                                    <Rectangle.Fill>
                                        <ImageBrush x:Name="HeroCover" Stretch="UniformToFill" />
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                            <StackPanel x:Name="HeroText" Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <local:EqualizerBars x:Name="HeroEqualizer" BarBrush="{StaticResource Shell.Accent}" Margin="0,0,8,1" VerticalAlignment="Center" />
                                    <local:MiSansLabel x:Name="HeroLabel" Text="正在播放" FontSize="12" FontWeight="{DynamicResource Shell.SemiboldWeight}" Foreground="{StaticResource Shell.Accent}" />
                                </StackPanel>
                                <local:MiSansLabel x:Name="HeroTitle" Style="{StaticResource Shell.Heading}" FontSize="32" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                                <local:MiSansLabel x:Name="HeroArtist" FontSize="16" Foreground="#D1D1D6" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <local:MiSansLabel x:Name="HeroSource" FontSize="12" Foreground="{StaticResource Shell.Secondary}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button x:Name="HeroPlay" Style="{StaticResource Shell.PrimaryPill}" local:ShellAssist.CornerRadius="9" Click="TogglePlayback" MinWidth="108" AutomationProperties.Name="播放">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle x:Name="HeroPlayGlyph" Style="{StaticResource GlyphMask}" Margin="0,0,7,0">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="{DynamicResource Apple.Music.PlayButton}" />
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                            <local:MiSansLabel x:Name="HeroPlayText" Text="播放" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <DockPanel Margin="0,0,0,16" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Shell.Pill}" Click="OpenNetEaseLibrary" Tag="daily" Content="每日推荐" />
                        <local:MiSansLabel Style="{StaticResource Shell.Heading}" Text="网易云音乐" VerticalAlignment="Center" />
                    </DockPanel>

                    <local:MiSansLabel Style="{StaticResource Shell.Heading}" Text="推荐歌单" FontSize="17" Margin="0,4,0,0" />
                    <local:MiSansLabel x:Name="RecommendedStatus" Style="{StaticResource Shell.Caption}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    <ItemsControl x:Name="RecommendedPlaylists" Tag="4" Margin="-10,12,-10,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Shell.Button}" Click="OpenRecommendedPlaylist" Tag="{Binding Playlist}"
                                        Margin="6,0,6,16" Padding="4" HorizontalContentAlignment="Stretch"
                                        AutomationProperties.Name="{Binding Playlist.Name}">
                                    <StackPanel>
                                        <Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                                            <Border CornerRadius="9" Background="{StaticResource Shell.SurfaceRaised}">
                                                <Image Source="{DynamicResource Apple.Music.Song}" Width="34" Height="34" Opacity="0.4" />
                                            </Border>
                                            <Rectangle RadiusX="9" RadiusY="9">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>
                                        <local:MiSansLabel Text="{Binding Playlist.Name}" FontWeight="{DynamicResource Shell.SemiboldWeight}" TextTrimming="CharacterEllipsis" Margin="0,9,0,2" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>


                </StackPanel>
            </local:ShellScrollViewer>

            <local:ShellScrollViewer x:Name="SearchPage" Grid.Row="1" Style="{StaticResource PageScroller}" ScrollChanged="OnPageScrolled">
                <StackPanel x:Name="SearchContent" Margin="40,16,40,36">
                    <Border x:Name="SearchTitleSlot" Style="{StaticResource PageTitleSlot}" />
                    <local:MiSansLabel x:Name="SearchSubtitle" Style="{StaticResource Shell.Caption}" FontSize="13" Margin="2,6,0,0" TextWrapping="Wrap" />
                    <TextBox x:Name="SearchQuery" Style="{StaticResource Shell.SearchBox}" Height="46" FontSize="16" Margin="0,18,0,0"
                             Tag="歌曲、艺人或专辑" KeyDown="OnSearchQueryKeyDown" AutomationProperties.Name="歌名或艺人" />



                    <DockPanel x:Name="SearchState" Margin="0,16,0,10">
                        <local:Spinner x:Name="SearchSpinner" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" Visibility="Collapsed" />
                        <local:MiSansLabel x:Name="SearchStatus" Style="{StaticResource Shell.Caption}" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                    <ListBox x:Name="SearchResults" ItemTemplate="{StaticResource NetEaseTrackRow}" Template="{StaticResource BareList}" Grid.IsSharedSizeScope="True" ItemContainerStyle="{StaticResource Shell.Row}"
                             VirtualizingPanel.IsVirtualizing="False" Background="Transparent" BorderThickness="0"
                             MouseDoubleClick="PlaySearchResult" KeyDown="OnSearchResultsKeyDown" AutomationProperties.Name="搜索结果">

                    </ListBox>
                </StackPanel>
            </local:ShellScrollViewer>

            <local:ShellScrollViewer x:Name="PlaylistPage" Grid.Row="1" Style="{StaticResource PageScroller}" ScrollChanged="OnPageScrolled">
                <StackPanel x:Name="PlaylistContent" Margin="40,16,40,36">
                    <Button Style="{StaticResource Shell.Button}" Click="ShowHomePage" Content="‹ 返回主页" HorizontalAlignment="Left" Padding="8,5" Margin="-8,0,0,12" />
                    <DockPanel>
                        <Rectangle x:Name="PlaylistArtwork" Width="104" Height="104" RadiusX="10" RadiusY="10" DockPanel.Dock="Left" Margin="0,0,16,0">
                            <Rectangle.Fill>
                                <ImageBrush x:Name="PlaylistCover" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel VerticalAlignment="Center">
                            <Border x:Name="PlaylistTitleSlot" Style="{StaticResource PageTitleSlot}" />
                            <Button x:Name="PlaylistPlayButton" Content="播放歌单" Style="{StaticResource Shell.PrimaryPill}"
                                    Click="PlayPlaylist" IsEnabled="False" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,18,0,10">
                        <local:Spinner x:Name="PlaylistSpinner" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" Visibility="Collapsed" />
                        <local:MiSansLabel x:Name="PlaylistStatus" Style="{StaticResource Shell.Caption}" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                    <ListBox x:Name="PlaylistTracks" ItemTemplate="{StaticResource NetEaseTrackRow}" Template="{StaticResource BareList}"
                             Grid.IsSharedSizeScope="True" ItemContainerStyle="{StaticResource Shell.Row}" Background="Transparent" BorderThickness="0"
                             MouseDoubleClick="PlaySearchResult" KeyDown="OnSearchResultsKeyDown" AutomationProperties.Name="歌单曲目" />
                    <Button x:Name="MoreNetEaseTracks" Style="{StaticResource Shell.Pill}" Visibility="Collapsed"
                            HorizontalAlignment="Left" Content="加载更多" Click="LoadMoreNetEaseTracks" Margin="0,14,0,0" />
                </StackPanel>
            </local:ShellScrollViewer>

            <local:ShellScrollViewer x:Name="SettingsPage" Grid.Row="1" Style="{StaticResource PageScroller}" ScrollChanged="OnPageScrolled">
                <Grid>
                <StackPanel x:Name="SettingsContent" MaxWidth="760" Margin="40,16,40,36">
                    <Border x:Name="SettingsTitleSlot" Style="{StaticResource PageTitleSlot}" Margin="0,0,0,22" />
                    <local:MiSansLabel Style="{StaticResource Shell.Heading}" FontSize="17" Text="播放" Margin="2,0,0,10" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <local:MiSansLabel Text="音量" />
                                    <local:MiSansLabel Text="本地音频与网易云播放共用" Style="{StaticResource Shell.Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <DockPanel Grid.Column="1">
                                    <local:MiSansLabel DockPanel.Dock="Right" Text="%" Style="{StaticResource Shell.Caption}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <TextBox x:Name="SettingsVolumeValue" DockPanel.Dock="Right" Width="64" Margin="12,0,0,0"
                                             Padding="7,4" TextAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="音量百分比" />
                                    <local:ShellSlider x:Name="SettingsVolume" Minimum="0" Maximum="100"
                                            IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                                            ValueChanged="OnVolumeChanged" AutomationProperties.Name="音量" />
                                </DockPanel>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Shell.Stroke}" Margin="0,14" />
                            <CheckBox x:Name="SettingsRealtimeSeek" Click="OnRealtimeSeekChanged">
                                <StackPanel>
                                    <local:MiSansLabel Text="拖动进度时实时跳转" />
                                    <local:MiSansLabel Text="关闭时松开进度条才跳转" Style="{StaticResource Shell.Caption}" Margin="0,3,0,0" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Expander x:Name="TypographySection" Header="界面字体 · MiSans">
                            <StackPanel Margin="0,12,0,0">
                                <DockPanel Margin="0,0,0,12">
                                    <local:MiSansLabel DockPanel.Dock="Left" Text="基准字重" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <TextBox x:Name="FontWeightValue" DockPanel.Dock="Right" Width="64" TextAlignment="Right" Margin="12,0,0,0"
                                             VerticalAlignment="Center" AutomationProperties.Name="MiSans 字重数值" />
                                    <local:ShellSlider x:Name="FontWeightSlider" Minimum="150" Maximum="700" Value="330" SmallChange="1" LargeChange="25"
                                                       TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                       AutomationProperties.Name="MiSans 字重" />
                                </DockPanel>
                                <TextBox x:Name="FontPreviewInput" MaxLength="240" Margin="0,0,0,8" AutomationProperties.Name="MiSans 样张文字" />
                                <Border Background="{StaticResource Shell.SurfaceRaised}" CornerRadius="8" Padding="10">
                                    <local:MiSansLabel x:Name="FontPreview" UseDirectWrite="True" FontSize="16" TextWrapping="Wrap"
                                                       Text="{Binding Text, ElementName=FontPreviewInput, Mode=OneWay}" AutomationProperties.Name="MiSans 样张" />
                                </Border>
                                <WrapPanel x:Name="FontFeatureList" Margin="0,10,0,6" />
                                <local:MiSansLabel Text="拖动时预览，松手后应用到主界面。" Style="{StaticResource Shell.Caption}" />
                            </StackPanel>
                        </Expander>
                    </Border>
                    <local:MiSansLabel Style="{StaticResource Shell.Heading}" FontSize="17" x:Name="LyricsSettingsHeading" Text="Apple Music 歌词" Margin="2,10,0,10" />
                    <Border Style="{StaticResource Card}" Padding="22,4,22,18">
                        <ContentControl x:Name="LyricsSettingsHost" Focusable="False" />
                    </Border>
                </StackPanel>
                </Grid>
            </local:ShellScrollViewer>

            <Grid x:Name="TitleBar" Height="44" Background="{StaticResource Shell.Background}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="TitleDock" SizeChanged="OnTitleSizeChanged" IsHitTestVisible="False" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="AccountButton" Style="{StaticResource Shell.Toggle}" Height="32" MaxWidth="132" Padding="9,4"
                            Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OpenAccount" ToolTip="网易云音乐账号" AutomationProperties.Name="网易云音乐账号">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE77B;" FontSize="14" />
                            <local:MiSansLabel x:Name="AccountButtonText" Text="账号" MaxWidth="92" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Shell.CaptionButton}" Click="MinimizeWindow" AutomationProperties.Name="最小化">
                        <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE921;" FontSize="11" />
                    </Button>
                    <Grid>
                        <Border x:Name="MaximizeHover" Background="#16FFFFFF" CornerRadius="7" Opacity="0" IsHitTestVisible="False" />
                        <Button x:Name="MaximizeWindowButton" Style="{StaticResource Shell.CaptionButton}" Click="ToggleWindowMaximize"
                                AutomationProperties.Name="最大化" PreviewMouseMove="UpdateMaximizePress"
                                PreviewMouseLeftButtonUp="EndMaximizePress" LostMouseCapture="CancelMaximizePress">
                            <TextBlock x:Name="MaximizeGlyph" Style="{StaticResource Shell.Glyph}" Text="&#xE922;" FontSize="11" RenderTransformOrigin="0.5,0.5" />
                        </Button>
                    </Grid>
                    <Button Style="{StaticResource Shell.CaptionButton}" Click="CloseWindow" AutomationProperties.Name="关闭">
                        <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE8BB;" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="TitleLayer" Grid.RowSpan="2" IsHitTestVisible="False" Panel.ZIndex="1" SizeChanged="OnTitleSizeChanged">
                <Grid.Clip>
                    <GeometryGroup FillRule="Nonzero">
                        <RectangleGeometry x:Name="DockedTitleClip" />
                        <RectangleGeometry x:Name="BodyTitleClip" />
                    </GeometryGroup>
                </Grid.Clip>
                <local:MiSansLabel x:Name="TitleText" Text="主页" Style="{StaticResource Shell.PageTitle}"
                                  HorizontalAlignment="Left" VerticalAlignment="Top" SizeChanged="OnTitleSizeChanged"
                                  TextTrimming="CharacterEllipsis" Visibility="Hidden" AutomationProperties.HeadingLevel="Level1">
                    <local:MiSansLabel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PageTitleScale" />
                            <TranslateTransform x:Name="PageTitleOffset" />
                            <TranslateTransform x:Name="PageTitleEntrance" />
                        </TransformGroup>
                    </local:MiSansLabel.RenderTransform>
                </local:MiSansLabel>
            </Grid>

            <Popup x:Name="AccountPopup" Placement="Custom" PlacementTarget="{Binding ElementName=AccountButton}"
                   StaysOpen="True" AllowsTransparency="True" Opened="OnAccountOpened" Closed="OnAccountClosed" PopupAnimation="None">
                <Grid>
                    <Border x:Name="AccountSurface" Style="{StaticResource Card}" Margin="0" Width="318" BorderBrush="{StaticResource Shell.Stroke}"
                            BorderThickness="1" RenderOptions.ClearTypeHint="Enabled" PreviewKeyDown="OnAccountKeyDown">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource Shell.SurfaceRaised}" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE77B;" Foreground="{StaticResource Shell.Secondary}" />
                                        <Rectangle RadiusX="20" RadiusY="20">
                                            <Rectangle.Fill>
                                                <ImageBrush x:Name="AccountPhoto" Stretch="UniformToFill" />
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <local:MiSansLabel x:Name="LoginTitle" FontWeight="{DynamicResource Shell.SemiboldWeight}" />
                                    <local:MiSansLabel x:Name="LoginDetail" Style="{StaticResource Shell.Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="LoginButton" Grid.Column="2" Style="{StaticResource Shell.Pill}" Click="ToggleLogin" VerticalAlignment="Center" />
                            </Grid>
                            <Button x:Name="LogoutButton" Content="退出本机登录" Click="LogoutAccount" Visibility="Collapsed" Style="{StaticResource Shell.Button}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                            <StackPanel x:Name="QrPanel" Visibility="Collapsed" Margin="0,14,0,2">
                                <Border Background="White" CornerRadius="12" Padding="10" Width="158" Height="158">
                                    <Grid>
                                        <Image x:Name="QrImage" AutomationProperties.Name="网易云登录二维码" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        <local:Spinner x:Name="QrSpinner" Foreground="#0D0D0F" Width="26" Height="26" />
                                    </Grid>
                                </Border>
                                <StackPanel Margin="0,12,0,0" VerticalAlignment="Center">
                                    <local:MiSansLabel Text="使用网易云音乐 App 扫码" FontSize="16" FontWeight="{DynamicResource Shell.SemiboldWeight}" />
                                    <local:MiSansLabel x:Name="QrStatus" Style="{StaticResource Shell.Caption}" FontSize="13" Margin="0,6,0,14" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="QrRetry" Style="{StaticResource Shell.Pill}" Content="刷新二维码" Click="RefreshQr" IsEnabled="False" />
                                        <Button Style="{StaticResource Shell.Button}" Content="取消" Click="CancelLogin" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Popup>

            <Border x:Name="Toast" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,18" Padding="16,10"
                    CornerRadius="12" Background="#F02A2A2F" BorderBrush="#26FFFFFF" BorderThickness="1" Opacity="0" IsHitTestVisible="False"
                    MaxWidth="560">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" />
                </Border.Effect>
                <local:MiSansLabel x:Name="Notice" TextWrapping="Wrap" FontSize="13" AutomationProperties.LiveSetting="Polite" />
            </Border>
        </Grid>

        <!-- Now playing bar -->
        <Border x:Name="PlaybackBar" Grid.Row="1" Grid.ColumnSpan="2" Background="#121214" BorderBrush="{StaticResource Shell.Stroke}" local:ShellTransitions.PlaybackFeedback="True"
                BorderThickness="0,1,0,0" Padding="16,10,16,6">
            <Grid x:Name="PlaybackLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TrackSummaryColumn" Width="*" MinWidth="190" />
                    <ColumnDefinition Width="1.7*" MaxWidth="640" />
                    <ColumnDefinition x:Name="PlaybackSideColumn" Width="*" MinWidth="132" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="TrackDetails" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="340">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="56" Height="56">
                        <Border CornerRadius="7" Background="{StaticResource Shell.SurfaceRaised}" />
                        <Rectangle x:Name="CoverFrame" RadiusX="7" RadiusY="7">
                            <Rectangle.Fill>
                                <ImageBrush x:Name="Cover" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    <StackPanel x:Name="NowText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,6,0">
                        <local:MiSansLabel x:Name="TrackTitle" FontWeight="{DynamicResource Shell.SemiboldWeight}" TextTrimming="CharacterEllipsis" />
                        <local:MiSansLabel x:Name="TrackArtist" Style="{StaticResource Shell.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FavoriteButton" Style="{StaticResource Shell.IconButton}" Width="32" Height="32" Click="ToggleFavorite"
                                ToolTip="收藏" AutomationProperties.Name="收藏">
                            <TextBlock x:Name="FavoriteGlyph" Style="{StaticResource Shell.Glyph}" Text="&#xEB51;" FontSize="15" />
                        </Button>
                        <Button x:Name="MoreButton" Style="{StaticResource Shell.IconButton}" Width="32" Height="32" Click="OpenTrackActions"
                                ToolTip="更多" AutomationProperties.Name="更多">
                            <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE712;" FontSize="15" />
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="TransportArea" Grid.Column="1" Margin="18,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ShuffleButton" Style="{StaticResource Shell.ModeButton}" Click="ToggleShuffle" ToolTip="随机播放" AutomationProperties.Name="随机播放" Margin="0,0,10,0">
                            <Image Source="{DynamicResource Apple.Music.ShuffleButton}" Width="24" Height="24" />
                        </Button>
                        <Button x:Name="PreviousButton" Click="PreviousTrack" ToolTip="上一首" AutomationProperties.Name="上一首" />
                        <Button x:Name="PlayButton" Click="TogglePlayback" ToolTip="播放" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="播放" />
                        <Button x:Name="NextButton" Click="NextTrack" ToolTip="下一首" AutomationProperties.Name="下一首" />
                        <Button x:Name="RepeatButton" Style="{StaticResource Shell.ModeButton}" Click="ToggleRepeat" ToolTip="循环播放" AutomationProperties.Name="循环播放" Margin="10,0,0,0">
                            <Image x:Name="RepeatGlyph" Source="{DynamicResource Apple.Music.RepeatButton}" Width="24" Height="24" />
                        </Button>
                    </StackPanel>
                    <Border Padding="4,0" CornerRadius="6" BorderThickness="1" Margin="0,2,0,0">
                        <reference:ReferenceStateBar x:Name="Progress" Height="36" AutomationProperties.Name="播放进度" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="NetEaseQualityButton" Style="{StaticResource Shell.Button}" Content="音质" Padding="7,4"
                            Visibility="Collapsed" Click="OpenQualityMenu" AutomationProperties.Name="网易云音质" />
                    <Button x:Name="MuteButton" Style="{StaticResource Shell.IconButton}" Click="ToggleMute" ToolTip="静音" AutomationProperties.Name="静音">
                        <TextBlock x:Name="VolumeGlyph" Style="{StaticResource Shell.Glyph}" Text="&#xE995;" FontSize="16" Foreground="#D1D1D6" />
                    </Button>
                    <local:ShellSlider x:Name="VolumeSlider" Width="96" Minimum="0" Maximum="100" Margin="4,0,14,0" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                            ValueChanged="OnVolumeChanged" AutomationProperties.Name="音量" />
                    <ToggleButton x:Name="QueueButton" Style="{StaticResource Shell.Toggle}" Width="36" Height="36" Padding="0"
                                  Click="ToggleQueuePopup" ToolTip="播放队列" AutomationProperties.Name="播放队列">
                        <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE90B;" />
                    </ToggleButton>
                    <Button x:Name="LyricsButton" Style="{StaticResource Shell.Pill}" Click="OpenLyricsPage" ToolTip="打开 Apple Music 歌词"
                            ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="打开 Apple Music 歌词">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{DynamicResource Apple.Quote}" Width="17" Height="17" />
                            <local:MiSansLabel Text="歌词" Margin="7,0,0,0" Style="{StaticResource RoomyOnly}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Popup x:Name="QueuePopup" Placement="Custom" PlacementTarget="{Binding ElementName=QueueButton}"
               StaysOpen="True" AllowsTransparency="True" Opened="OnQueuePopupOpened" Closed="OnQueuePopupClosed" PopupAnimation="None">
            <Border x:Name="QueueSurface" Background="{StaticResource Shell.Surface}" BorderBrush="{StaticResource Shell.Stroke}"
                    BorderThickness="1" CornerRadius="12" Padding="14" Width="428" RenderOptions.ClearTypeHint="Enabled" PreviewKeyDown="OnQueueKeyDown">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,9">
                        <local:MiSansLabel Style="{StaticResource Shell.Heading}" FontSize="18" Text="播放队列" />
                        <local:MiSansLabel x:Name="PlaylistCount" Style="{StaticResource Shell.Caption}" Margin="10,0,0,1" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <local:MiSansLabel x:Name="QueueEmpty" Style="{StaticResource Shell.Caption}" Text="播放队列为空"
                               Margin="4,6,4,10" Visibility="{Binding HasItems, ElementName=TrackList, Converter={x:Static local:LibraryView.CollapsedWhenTrue}}" />
                    <ListBox x:Name="TrackList" Tag="{Binding IsPlaybackActive, ElementName=ShellView}" ItemContainerStyle="{StaticResource Shell.Row}" Grid.IsSharedSizeScope="True"
                             MaxHeight="320" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="PlaySelectedTrack" KeyDown="OnTrackListKeyDown" AutomationProperties.Name="播放队列">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <local:ShellScrollViewer x:Name="QueueScroller" CanContentScroll="True" Focusable="False"
                                                         HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </local:ShellScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="Auto" MinWidth="44" SharedSizeGroup="QueueDuration" />
                                        <ColumnDefinition Width="68" />
                                    </Grid.ColumnDefinitions>
                                    <local:MiSansLabel x:Name="Number" Text="{Binding Number}" Foreground="{StaticResource Shell.Tertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <local:EqualizerBars x:Name="Playing" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         BarBrush="{StaticResource Shell.Accent}"
                                                         IsActive="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    <Grid Grid.Column="1" Width="44" Height="44" HorizontalAlignment="Left">
                                        <Border CornerRadius="8" Background="{StaticResource Shell.SurfaceRaised}">
                                            <Image Source="{DynamicResource Apple.Music.Song}" Width="20" Height="20" Opacity="0.4" />
                                        </Border>
                                        <Rectangle RadiusX="8" RadiusY="8">
                                            <Rectangle.Fill>
                                                <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <local:MiSansLabel x:Name="Title" Text="{Binding Track.Title}" FontWeight="{DynamicResource Shell.SemiboldWeight}" TextTrimming="CharacterEllipsis" />
                                        <local:MiSansLabel Text="{Binding Track.Artist}" Style="{StaticResource Shell.Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <local:MiSansLabel Grid.Column="3" Text="{Binding Track.Album}" Style="{StaticResource Shell.Caption}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <local:MiSansLabel Grid.Column="4" Text="{Binding Duration}" Style="{StaticResource Shell.Caption}" FontSize="13" TextTrimming="None"
                                                      VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button x:Name="QueueTrackPlay" Style="{StaticResource Shell.IconButton}" Width="32" Height="32"
                                                Click="PlayQueueTrack" ToolTip="播放"
                                                AutomationProperties.Name="{Binding Track.Title, StringFormat='播放 {0}'}">
                                            <Image Source="{DynamicResource Apple.Music.PlayButton}" Width="22" Height="22">
                                                <Image.RenderTransform><TranslateTransform X="1" /></Image.RenderTransform>
                                            </Image>
                                        </Button>
                                        <Button x:Name="QueueTrackRemove" Style="{StaticResource Shell.IconButton}" Width="32" Height="32"
                                                Click="RemoveQueueTrack" ToolTip="移除"
                                                AutomationProperties.Name="{Binding Track.Title, StringFormat='从队列移除 {0}'}">
                                            <TextBlock Style="{StaticResource Shell.Glyph}" Text="&#xE711;" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Playing" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Shell.Accent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
