<Window x:Class="LyricReplica.App.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:reference="clr-namespace:LyricReplica.App.Reference"
        Title="LyricReplica · 播放器" Width="1240" Height="780" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#0F0F11" Foreground="#F2F2F4"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedText" Color="#86868C" />
        <SolidColorBrush x:Key="SecondaryText" Color="#A9A9AF" />
        <SolidColorBrush x:Key="Sidebar" Color="#17171A" />
        <SolidColorBrush x:Key="Raised" Color="#26262A" />
        <SolidColorBrush x:Key="Hover" Color="#1F1F23" />
        <SolidColorBrush x:Key="TransportSurface" Color="#17171A" />
        <SolidColorBrush x:Key="Accent" Color="#F2F2F4" />
        <SolidColorBrush x:Key="Highlight" Color="#FA2D48" />
        <SolidColorBrush x:Key="SeparatorBrush" Color="#26262A" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="Width" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="Margin" Value="12,0,0,6" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#F2F2F4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="#DCDCE0" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="TransportMode" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Opacity" Value="0.62" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Background" Value="#2E2E33" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderBrush" Value="#5A5A60" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="18" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1AFFFFFF" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#F2F2F4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#F2F2F4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#F2F2F4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Focus" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="BorderBrush" Value="#F2F2F4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Focus" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F2F2F4" />
            <Setter Property="CaretBrush" Value="#F2F2F4" />
            <Setter Property="SelectionBrush" Value="#FA2D48" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" Background="#232327" CornerRadius="8" BorderThickness="1" BorderBrush="#2E2E33" Height="34">
                            <Grid Margin="10,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="13"
                                           Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{StaticResource MutedText}"
                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#46464C" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#F2F2F4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#F2F2F4" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#232327" />
                                <Setter Property="Foreground" Value="{StaticResource Highlight}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="#F2F2F4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Margin="4,2,2,2">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="24">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Handle" Background="#4A4A50" CornerRadius="3" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Handle" Property="Background" Value="#8A8A90" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Handle" Property="Background" Value="#B4B4B9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="PlayerContent" IsEnabled="False" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,12">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,16">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Highlight}">
                            <Image Source="{DynamicResource Apple.Music.Song}" Width="18" Height="18" />
                        </Border>
                        <TextBlock Text="LyricReplica" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBox x:Name="SidebarSearch" Style="{StaticResource SearchBox}" Tag="搜索网易云音乐" Margin="0,0,0,18"
                             KeyDown="OnSidebarSearchKeyDown" AutomationProperties.Name="搜索网易云音乐，按回车搜索" />

                    <TextBlock Style="{StaticResource SectionLabel}" Text="资料库" />
                    <Border Background="{StaticResource Raised}" CornerRadius="8" Padding="10,8" Margin="0,0,0,18">
                        <Grid>
                            <Border Width="3" Height="16" CornerRadius="2" Background="{StaticResource Highlight}"
                                    HorizontalAlignment="Left" Margin="-8,0,0,0" />
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{DynamicResource Apple.Music.Playlist}" Width="18" Height="18" Margin="0,0,10,0" />
                                <TextBlock Text="播放列表" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="音乐来源" />
                    <Button Style="{StaticResource RailButton}" Click="OpenNetEaseSearch" AutomationProperties.Name="网易云音乐">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE774;" />
                            <TextBlock Text="网易云音乐" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Click="OpenAudio" AutomationProperties.Name="添加音频">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE710;" />
                            <TextBlock Text="添加音频" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Click="ImportLyrics" AutomationProperties.Name="导入歌词">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8A5;" />
                            <TextBlock Text="导入歌词" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Click="ConnectMedia" AutomationProperties.Name="连接系统媒体">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE703;" />
                            <TextBlock Text="连接系统媒体" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="4,0,4,8" />
                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource RailButton}" Click="OpenPlayerSettings" ToolTip="播放器设置" AutomationProperties.Name="播放器设置">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;" Width="24" />
                                <TextBlock Text="播放设置" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RailButton}" Click="OpenLyricsSettings" ToolTip="Apple Music 歌词设置" AutomationProperties.Name="Apple Music 歌词设置">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{DynamicResource Apple.Quote}" Width="16" Height="16" Margin="0,0,8,0" Opacity="0.7" />
                                <TextBlock Text="歌词设置" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
                <Grid />
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      SizeChanged="OnPageSizeChanged" Focusable="False">
            <StackPanel Margin="36,28,36,28">
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="播放列表" FontSize="32" FontWeight="Bold" />
                    <TextBlock x:Name="PlaylistCount" Foreground="{StaticResource MutedText}" FontSize="13" Margin="2,4,0,0" />
                </StackPanel>

                <TextBlock Style="{StaticResource SectionHeading}" Text="快速播放" Margin="0,0,0,14" />
                <ItemsControl x:Name="CoverShelf" Tag="5" Margin="-8,0,-8,28" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="Tile" Style="{StaticResource TileButton}" Click="OpenCoverTrack" Tag="{Binding Track}"
                                    AutomationProperties.Name="{Binding Track.Title}" Margin="8,0,8,12">
                                <StackPanel>
                                    <Grid x:Name="Art" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                                        <Border Background="{StaticResource Raised}" CornerRadius="8">
                                            <Image Source="{DynamicResource Apple.Music.Song}" Width="44" Height="44" Opacity="0.35" />
                                        </Border>
                                        <Rectangle RadiusX="8" RadiusY="8">
                                            <Rectangle.Fill>
                                                <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Border x:Name="Shade" CornerRadius="8" Opacity="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0.4" />
                                                    <GradientStop Color="#99000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource Highlight}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10">
                                                <Image Source="{DynamicResource Apple.Music.PlayButton}" Width="22" Height="22" Margin="2,0,0,0" />
                                            </Border>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Track.Title}" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Track.Artist}" Foreground="{StaticResource SecondaryText}" FontSize="12"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Shade" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger SourceName="Tile" Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Shade" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource SectionHeading}" Text="歌曲" Margin="0,0,0,12" />
                <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="9,0,9,8" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="标题" FontSize="12" Foreground="{StaticResource MutedText}" />
                        <TextBlock Grid.Column="2" Text="专辑" FontSize="12" Foreground="{StaticResource MutedText}" Margin="12,0,0,0" />
                    </Grid>
                </Border>
                <ListBox x:Name="TrackList" BorderThickness="0" Background="Transparent"
                         VirtualizingPanel.IsVirtualizing="False"
                         MouseDoubleClick="PlaySelectedTrack" KeyDown="OnTrackListKeyDown" AutomationProperties.Name="播放列表">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="5" Background="{StaticResource Raised}" HorizontalAlignment="Left">
                                    <Image Source="{DynamicResource Apple.Music.Song}" Width="20" Height="20" Opacity="0.45" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{StaticResource SecondaryText}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Album}" FontSize="13" Foreground="{StaticResource SecondaryText}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="PlaybackBar" Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource TransportSurface}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0" Padding="16,10,16,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" MaxWidth="320" />
                    <ColumnDefinition Width="1.7*" MaxWidth="620" />
                    <ColumnDefinition Width="*" MinWidth="150" MaxWidth="320" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="TrackDetails" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="6" Background="{StaticResource Raised}">
                        <Rectangle RadiusX="6" RadiusY="6">
                            <Rectangle.Fill>
                                <ImageBrush x:Name="Cover" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,4,0">
                        <TextBlock x:Name="TrackTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TrackArtist" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SourceLabel" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FavoriteButton" Style="{StaticResource IconButton}" Width="32" Height="32" MinHeight="32"
                                Click="ToggleFavorite" ToolTip="收藏" AutomationProperties.Name="收藏">
                            <TextBlock x:Name="FavoriteGlyph" FontFamily="{StaticResource IconFont}" Text="&#xEB51;" FontSize="15" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="32" Height="32" MinHeight="32" Click="OpenTrackActions"
                                ToolTip="曲目与歌词选项" AutomationProperties.Name="更多">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE712;" FontSize="15" />
                            <Button.ContextMenu>
                                <ContextMenu Placement="Top">
                                    <MenuItem Header="为当前曲目关联音频…" Click="AttachAudio" />
                                    <MenuItem Header="更换封面…" Click="OpenCover" />
                                    <MenuItem Header="Apple Music 歌词设置…" Click="OpenLyricsSettings" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Margin="16,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="ShuffleButton" Style="{StaticResource TransportMode}" Click="ToggleShuffle"
                                ToolTip="随机播放" AutomationProperties.Name="随机播放" Margin="0,0,8,0">
                            <Image Source="{DynamicResource Apple.Music.ShuffleButton}" Width="24" Height="24" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="PreviousTrack" ToolTip="上一首" AutomationProperties.Name="上一首">
                            <Image Source="{DynamicResource Apple.Music.PreviousButton}" Width="28" Height="28" />
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Click="TogglePlayback" Width="44" Height="44"
                                Margin="8,0" ToolTip="播放" AutomationProperties.Name="播放">
                            <Image x:Name="PlayGlyph" Source="{DynamicResource Apple.Music.PlayButton}" Width="36" Height="36" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="NextTrack" ToolTip="下一首" AutomationProperties.Name="下一首">
                            <Image Source="{DynamicResource Apple.Music.NextButton}" Width="28" Height="28" />
                        </Button>
                        <Button x:Name="RepeatButton" Style="{StaticResource TransportMode}" Click="ToggleRepeat"
                                ToolTip="循环播放" AutomationProperties.Name="循环播放" Margin="8,0,0,0">
                            <Image Source="{DynamicResource Apple.Music.RepeatButton}" Width="24" Height="24" />
                        </Button>
                    </StackPanel>
                    <Border Padding="4,0" CornerRadius="6" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <reference:ReferenceStateBar x:Name="Progress" Height="36" AutomationProperties.Name="播放进度" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="OpenPlayerSettings" ToolTip="音量与播放器设置"
                            AutomationProperties.Name="音量与播放器设置" Margin="0,0,10,0">
                        <Image Source="{DynamicResource Apple.Music.VolumeButton}" Width="20" Height="20" Opacity="0.85" />
                    </Button>
                    <Button x:Name="LyricsButton" Style="{StaticResource PillButton}" Click="OpenLyricsPage"
                            ToolTip="打开 Apple Music 歌词" AutomationProperties.Name="打开 Apple Music 歌词">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{DynamicResource Apple.Quote}" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="歌词" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="Notice" Grid.Row="1" Grid.ColumnSpan="3" FontSize="12" Foreground="{StaticResource SecondaryText}"
                           AutomationProperties.LiveSetting="Polite" TextTrimming="CharacterEllipsis" Visibility="Collapsed" Margin="0,4,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
