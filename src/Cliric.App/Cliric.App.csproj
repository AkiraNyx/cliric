<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Cliric</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)../../tools/capsule-preview-packages;$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CapsulePlayerDemo" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.2.0" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" Aliases="emoji" />
    <PackageReference Include="LiquidGlassEngineering.Wpf" Version="1.0.2" GeneratePathProperty="true" />
    <Reference Include="ColorThief.Netstandard.v20"><HintPath>../../vendor/ColorThief/ColorThief.Netstandard.v20.dll</HintPath><Private>true</Private></Reference>
    <ProjectReference Include="../Cliric.Core/Cliric.Core.csproj" />
    <ProjectReference Include="../../vendor/Lyricify-Backgrounds/Lyricify.Backgrounds.AppleMusicInspired.Ios.Wpf/Lyricify.Backgrounds.AppleMusicInspired.Ios.Wpf.csproj" />
    <ProjectReference Include="../../vendor/Lyricify-Backgrounds/Lyricify.Backgrounds.AppleMusicInspired.IosClassic.Wpf/Lyricify.Backgrounds.AppleMusicInspired.IosClassic.Wpf.csproj" />
    <None Include="../../vendor/Lyricify-Backgrounds/LICENSE.txt" Link="licenses/Lyricify-Backgrounds.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../vendor/Lyricify-Lyrics-Helper/LICENSE" Link="licenses/Lyricify-Lyrics-Helper.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../vendor/Wpf.Ui/LICENSE.txt" Link="licenses/Wpf.Ui.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../vendor/MiSans/LICENSE.pdf" Link="licenses/MiSans.pdf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets/Fonts/*.otf" />
    <Resource Include="Assets/Fonts/*.ttf" />
    <Resource Include="Assets/Shaders/*.ps" />
    <None Update="Media/NetEaseClient.cjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../tests/Cliric.Tests/Fixtures/settings-controls-original.json" LogicalName="settings-controls-original.json" />
    <EmbeddedResource Include="../../tests/Cliric.Tests/Fixtures/plus-lighter-original.json" LogicalName="plus-lighter-original.json" />
    <EmbeddedResource Include="../../tests/Cliric.Tests/Fixtures/isolation-original.json" LogicalName="isolation-original.json" />
    <EmbeddedResource Include="../../tests/Cliric.Tests/Fixtures/palette-original.json" LogicalName="palette-original.json" />
    <EmbeddedResource Include="../../tests/Cliric.Tests/Fixtures/layout-original.json" LogicalName="layout-original.json" />
    <EmbeddedResource Include="../../tests/Cliric.Tests/Fixtures/fonts-original.json" LogicalName="reference-fonts.json" />
    <EmbeddedResource Include="../../tests/Cliric.Tests/Fixtures/early-finish-original.json" LogicalName="early-finish-original.json" />
    <EmbeddedResource Include="../../tests/Cliric.Tests/Fixtures/word-reset-original.json" LogicalName="word-reset-original.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(PkgLiquidGlassEngineering_Wpf)' != ''">
    <None Include="$(PkgLiquidGlassEngineering_Wpf)/LICENSE;$(PkgLiquidGlassEngineering_Wpf)/NOTICE.md"
          Link="licenses/LiquidGlassEngineering/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
