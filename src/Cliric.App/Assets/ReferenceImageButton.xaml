<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.Children>
      <Border Background="#FFFFFFFF" Opacity="0.00001" />
      <Grid x:Name="GridScale">
        <Grid.Children>
          <Border CornerRadius="200" Background="#FFFFFFFF" Opacity="0.0001" Margin="-5" x:Name="BorderBackground" />
          <Image Source="{Binding ImageSource}" x:Name="Image" />
        </Grid.Children>
      </Grid>
    </Grid.Children>
  </Grid>
</UserControl>