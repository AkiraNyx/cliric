<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:p="clr-namespace:Cliric.App.Reference" xmlns:local="clr-namespace:Cliric.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="#FFFFFFFF" RenderTransformOrigin="0,0.5">
  <UserControl.RenderTransform>
    <TransformGroup>
      <ScaleTransform />
      <TranslateTransform />
    </TransformGroup>
  </UserControl.RenderTransform>
  <Grid x:Name="GridOutside">
    <Grid.RenderTransform>
      <TranslateTransform />
    </Grid.RenderTransform>
    <Grid.Children>
      <Border Opacity="0" Background="#FFFFFFFF" CornerRadius="15" x:Name="BorderBackgroundBackCover" />
      <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.Children>
          <Border Grid.ColumnSpan="3" Opacity="0" Background="#FFFFFFFF" p:RoundedClip.CornerRadius="15" x:Name="BorderBackground" />
          <p:GridSpacing Grid.Column="2" Spacing="0.1" WidthBinding="{Binding ElementName=MainGrid, Path=ActualWidth}" x:Name="GridForSpacing" />
          <StackPanel Grid.Column="1" Opacity="0.4" ClipToBounds="False" VerticalAlignment="Center" Margin="20,15,20,15" x:Name="StackPanelLyrics">
            <StackPanel.Children>
              <ContentControl Visibility="Visible" VerticalAlignment="Top" FontWeight="{Binding FontWeight, ElementName=TextBlockLyrics}" FontSize="{Binding FontSize, ElementName=TextBlockLyrics}" HorizontalContentAlignment="{Binding HorizontalAlignment, ElementName=TextBlockLyrics}" x:Name="TextSing" />
              <local:LyricTextBlock Text="" LineHeight="49" FontWeight="Bold" FontSize="41" TextWrapping="Wrap" HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Top" x:Name="TextBlockLyrics" />
              <TextBlock Margin="0,4,0,-5.5" Text="" FontWeight="Medium" LineHeight="32" TextWrapping="Wrap" Visibility="Collapsed" FontSize="{Binding FontSize, ElementName=TextBlockTranslation}" Opacity="{Binding Opacity, ElementName=TextBlockTranslation}" TextAlignment="{Binding TextAlignment, ElementName=TextBlockLyrics}" HorizontalAlignment="{Binding HorizontalAlignment, ElementName=TextBlockLyrics}" x:Name="TextBlockRomaji" />
              <TextBlock Margin="0,11,0,-5" Text="" FontWeight="Medium" FontSize="24" LineHeight="38" TextWrapping="Wrap" TextAlignment="{Binding TextAlignment, ElementName=TextBlockLyrics}" HorizontalAlignment="{Binding HorizontalAlignment, ElementName=TextBlockLyrics}" x:Name="TextBlockTranslation" />
            </StackPanel.Children>
          </StackPanel>
        </Grid.Children>
      </Grid>
      <GroupBox Visibility="Collapsed">
        <GroupBox.ContextMenu>
          <ContextMenu x:Name="MenuRightClick">
            <ContextMenu.Items>
              <MenuItem Header="{DynamicResource String.Menu.MainWindow.MainLyricsLine.Menu.Copy}" x:Name="MenuItemCopy" />
              <MenuItem Header="{DynamicResource String.Menu.MainWindow.MainLyricsLine.Menu.CopyTranslation}" x:Name="MenuItemCopyTranslation" />
              <MenuItem Header="{DynamicResource String.Menu.MainWindow.MainLyricsLine.Menu.CopyLineWithTranslation}" x:Name="MenuItemCopyLineWithTranslation" />
              <Separator />
              <MenuItem Header="{DynamicResource String.Menu.MainWindow.MainLyricsLine.Menu.CopyAllLines}" x:Name="MenuItemCopyAllLines" />
              <MenuItem Header="{DynamicResource String.Menu.MainWindow.MainLyricsLine.Menu.CopyAllTranslations}" x:Name="MenuItemCopyAllTranslations" />
              <MenuItem Header="{DynamicResource String.Menu.MainWindow.MainLyricsLine.Menu.CopyAllLinesWithTranslation}" x:Name="MenuItemCopyAllLinesWithTranslation" />
              <Separator />
              <MenuItem Header="{DynamicResource String.Menu.MainWindow.MainLyricsLine.Menu.Share}" x:Name="MenuItemShare" />
            </ContextMenu.Items>
          </ContextMenu>
        </GroupBox.ContextMenu>
      </GroupBox>
    </Grid.Children>
  </Grid>
</UserControl>
