<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>../../src/Cliric.App/app.manifest</ApplicationManifest>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)../../tools/capsule-preview-packages;$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Cliric.App/Cliric.App.csproj" />
  </ItemGroup>
</Project>
